// skyforge-random

функция сгенерировать_пароль(длина) {
    пусть алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*"
    пусть результат = ""
    пусть энтропия = время_сейчас() + случайное_число(0, 1000000)
    
    для i от 1 до длина {
        пусть индекс = (энтропия + i * 17) % длина(алфавит)
        результат = результат + алфавит[индекс]
    }
    вернуть результат
}
